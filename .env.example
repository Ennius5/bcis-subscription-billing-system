DATABASE_URL=postgresql://bcis_app:CHANGE_ME@localhost:5432/bcis
API_HOST=0.0.0.0
API_PORT=3000
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_MIN_10_CHARS

# Where uploaded GCash proof images are kept (relative to the API's working directory,
# or absolute). Back this folder up together with the database.
PROOF_STORAGE_DIR=attachments/payment-proofs

TEST_DATABASE_URL=postgresql://bcis_app:CHANGE_ME@localhost:5432/bcis_test
SEED_DEMO_PASSWORD=choose-a-demo-password

# Backups (Administration > Backup & Restore, and `pnpm --filter ./apps/api backup`).
# Each backup is a folder here; copy them to an external drive regularly.
BACKUP_DIR=backups
# Folder of pg_dump/pg_restore when they are not on PATH, e.g. C:\Program Files\PostgreSQL\18\bin
PG_BIN_DIR=

# API log files, one per day, kept 30 days. Levels: fatal, error, warn, info, debug.
LOG_DIR=logs
LOG_LEVEL=info
